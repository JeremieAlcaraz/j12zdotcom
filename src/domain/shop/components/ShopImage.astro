---
import ImageMod from '@/ui/atoms/ImageMod.astro'

interface Props {
  src: string
  alt: string
  class?: string
  width: number
  height: number
  loading?: 'eager' | 'lazy'
  decoding?: 'async' | 'auto' | 'sync'
  format?: 'auto' | 'avif' | 'jpeg' | 'png' | 'svg' | 'webp'
}

const { src, alt, class: className, width, height, loading = 'lazy', decoding = 'async', format } =
  Astro.props as Props

const isRemote = /^https?:\/\//.test(src)
---

{isRemote ? (
  <img
    src={src}
    alt={alt}
    class={className}
    width={width}
    height={height}
    loading={loading}
    decoding={decoding}
  />
) : (
  <ImageMod
    src={src}
    alt={alt}
    class={className}
    width={width}
    height={height}
    loading={loading}
    decoding={decoding}
    format={format}
  />
)}
