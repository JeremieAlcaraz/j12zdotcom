---
import Icon from '@/ui/atoms/Icon.astro'
import RadioInput from '@/ui/atoms/RadioInput.astro'
import RadioLabel from '@/ui/atoms/RadioLabel.astro'
import Divider from '@/ui/atoms/Divider.astro'
import type { ShopFilterOption, ShopFiltersView } from '@/domain/shop/types'

interface Props {
  filters: ShopFiltersView
  id?: string
  title?: string
  class?: string
}

const {
  filters,
  id = `shop-filters-${Math.random().toString(36).slice(2, 8)}`,
  title = 'Filtres',
  class: className,
} = Astro.props as Props
const {
  quickFilters,
  defaultQuickFilterId,
  offerTypes,
  defaultOfferTypeId,
  productTypes,
  serviceTypes,
  categories,
  defaultCategoryId,
} = filters

const getDefaultId = (options: ShopFilterOption[], explicitId?: string) =>
  explicitId ?? options.find((option) => option.checked)?.id ?? options[0]?.id

const defaultQuickFilter = getDefaultId(quickFilters, defaultQuickFilterId)
const defaultOfferType = getDefaultId(offerTypes, defaultOfferTypeId)
const defaultCategory = getDefaultId(categories, defaultCategoryId)

const quickFiltersName = `${id}-quick`
const offerTypesName = `${id}-offers`
const productTypesName = `${id}-products`
const serviceTypesName = `${id}-services`
const categoriesName = `${id}-categories`

const sidebarClasses = [
  'fixed left-0 top-0 z-50 flex h-full w-80 max-w-[85vw] -translate-x-full flex-col gap-6 overflow-y-auto border-r border-base-200 bg-base-100/95 p-6 shadow-xl transition-transform duration-300 lg:sticky lg:top-24 lg:h-[calc(100vh-6rem)] lg:w-72 lg:max-w-none lg:translate-x-0 lg:rounded-3xl lg:border lg:bg-base-100/70 lg:shadow-none',
  className,
]
  .filter(Boolean)
  .join(' ')

const sectionLabelClasses = 'text-xs font-semibold text-base-content/60'
const sectionStackClasses = 'mt-3 space-y-2'
const optionTextClasses = 'text-sm text-base-content/80'
---

<div data-shop-sidebar-root={id} data-shop-type-default={defaultOfferType}>
  <div
    class="fixed inset-0 z-40 bg-black/20 opacity-0 pointer-events-none backdrop-blur-sm transition-opacity duration-300 lg:hidden"
    data-shop-sidebar-overlay
  ></div>

  <aside
    class={sidebarClasses}
    data-shop-sidebar-panel
    id={id}
    aria-label={title}
    aria-hidden="false"
    style="scrollbar-gutter: stable;"
  >
    <div class="flex items-center justify-between lg:hidden">
      <h2 class="text-lg font-semibold text-base-content">{title}</h2>
      <button
        type="button"
        class="btn btn-ghost btn-circle"
        data-shop-sidebar-close
        aria-label="Fermer les filtres"
      >
        <Icon name="lucide:x" size={20} />
      </button>
    </div>

    <div class="space-y-4">
      <section>
        <p class={sectionLabelClasses}>Essentiels</p>
        <div class={sectionStackClasses}>
          {
            quickFilters.map((option) => (
              <RadioLabel variant="default" class="px-2 py-1.5">
                <RadioInput
                  name={quickFiltersName}
                  value={option.id}
                  checked={option.id === defaultQuickFilter}
                  color="primary"
                  size="sm"
                />
                <span class={optionTextClasses}>{option.label}</span>
              </RadioLabel>
            ))
          }
        </div>
      </section>

      <Divider variant="primary" style="gradient" />

      <section data-shop-type-view="main">
        <p class={sectionLabelClasses}>Type</p>
        <div class={sectionStackClasses}>
          {
            offerTypes.map((option) => (
              <RadioLabel variant="default" class="px-2 py-1.5">
                <RadioInput
                  name={offerTypesName}
                  value={option.id}
                  checked={option.id === defaultOfferType}
                  color="primary"
                  size="sm"
                  data-shop-type-input
                />
                <span class={optionTextClasses}>{option.label}</span>
              </RadioLabel>
            ))
          }
        </div>
      </section>

      <section class="hidden" data-shop-type-view="products" aria-hidden="true">
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="btn btn-ghost btn-xs h-7 min-h-7 w-7 p-0"
            data-shop-type-back
            aria-label="Retour aux types"
          >
            <Icon name="lucide:arrow-left" size={14} />
          </button>
          <p class={sectionLabelClasses}>Produits</p>
        </div>
        <div class={sectionStackClasses}>
          {
            productTypes.map((option) => (
              <RadioLabel variant="default" class="px-2 py-1.5">
                <RadioInput
                  name={productTypesName}
                  value={option.id}
                  checked={option.checked}
                  color="primary"
                  size="sm"
                />
                <span class={optionTextClasses}>{option.label}</span>
              </RadioLabel>
            ))
          }
        </div>
      </section>

      <section class="hidden" data-shop-type-view="services" aria-hidden="true">
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="btn btn-ghost btn-xs h-7 min-h-7 w-7 p-0"
            data-shop-type-back
            aria-label="Retour aux types"
          >
            <Icon name="lucide:arrow-left" size={14} />
          </button>
          <p class={sectionLabelClasses}>Services</p>
        </div>
        <div class={sectionStackClasses}>
          {
            serviceTypes.map((option) => (
              <RadioLabel variant="default" class="px-2 py-1.5">
                <RadioInput
                  name={serviceTypesName}
                  value={option.id}
                  checked={option.checked}
                  color="primary"
                  size="sm"
                />
                <span class={optionTextClasses}>{option.label}</span>
              </RadioLabel>
            ))
          }
        </div>
      </section>

      <Divider variant="primary" style="gradient" />

      <section>
        <p class={sectionLabelClasses}>Categories</p>
        <div class={sectionStackClasses}>
          {
            categories.map((category) => (
              <RadioLabel variant="default" class="px-2 py-1.5">
                <RadioInput
                  name={categoriesName}
                  value={category.id}
                  checked={category.id === defaultCategory}
                  color="primary"
                  size="sm"
                />
                <span class={optionTextClasses}>{category.label}</span>
              </RadioLabel>
            ))
          }
        </div>
      </section>
    </div>
  </aside>
</div>

<script define:vars={{ sidebarId: id }} is:inline>
  ;(() => {
    let cleanupFn = null

    const initShopSidebar = () => {
      if (cleanupFn) {
        cleanupFn()
        cleanupFn = null
      }

      const root = document.querySelector(`[data-shop-sidebar-root="${sidebarId}"]`)
      if (!root) return

      const panel = root.querySelector('[data-shop-sidebar-panel]')
      const overlay = root.querySelector('[data-shop-sidebar-overlay]')
      const openButtons = document.querySelectorAll(`[data-shop-sidebar-open="${sidebarId}"]`)
      const closeButtons = root.querySelectorAll('[data-shop-sidebar-close]')

      const listeners = []

      if (panel && overlay) {
        let isOpen = false

        const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches

        const applyState = () => {
          const shouldOpen = isOpen || isDesktop()
          panel.classList.toggle('translate-x-0', shouldOpen)
          panel.classList.toggle('-translate-x-full', !shouldOpen)
          panel.setAttribute('aria-hidden', shouldOpen ? 'false' : 'true')

          const showOverlay = isOpen && !isDesktop()
          overlay.classList.toggle('opacity-100', showOverlay)
          overlay.classList.toggle('opacity-0', !showOverlay)
          overlay.classList.toggle('pointer-events-none', !showOverlay)

          openButtons.forEach((button) => {
            button.setAttribute('aria-expanded', showOverlay ? 'true' : 'false')
          })
        }

        const open = () => {
          isOpen = true
          applyState()
        }

        const close = () => {
          isOpen = false
          applyState()
        }

        applyState()

        openButtons.forEach((button) => {
          button.addEventListener('click', open)
          listeners.push(() => button.removeEventListener('click', open))
        })

        closeButtons.forEach((button) => {
          button.addEventListener('click', close)
          listeners.push(() => button.removeEventListener('click', close))
        })

        overlay.addEventListener('click', close)
        listeners.push(() => overlay.removeEventListener('click', close))

        const handleResize = () => applyState()
        const handleKeydown = (event) => {
          if (event.key === 'Escape' && isOpen) close()
        }

        window.addEventListener('resize', handleResize)
        document.addEventListener('keydown', handleKeydown)

        listeners.push(() => window.removeEventListener('resize', handleResize))
        listeners.push(() => document.removeEventListener('keydown', handleKeydown))
      }

      const setupTypeViews = () => {
        const typeInputs = root.querySelectorAll('[data-shop-type-input]')
        const typeViews = root.querySelectorAll('[data-shop-type-view]')
        const defaultType = root.getAttribute('data-shop-type-default') || 'all'

        if (!typeInputs.length || !typeViews.length) return

        const ensureDefaultType = () => {
          const selected = root.querySelector('[data-shop-type-input]:checked')
          if (!selected) {
            const fallbackInput = root.querySelector(`[data-shop-type-input][value="${defaultType}"]`)
            if (fallbackInput) {
              fallbackInput.checked = true
            }
          }
        }

        const updateTypeViews = () => {
          ensureDefaultType()
          const selected = root.querySelector('[data-shop-type-input]:checked')?.value ?? defaultType
          const currentView = selected === 'products' || selected === 'services' ? selected : 'main'

          typeViews.forEach((section) => {
            const view = section.getAttribute('data-shop-type-view')
            const shouldShow = view === currentView
            section.classList.toggle('hidden', !shouldShow)
            section.setAttribute('aria-hidden', shouldShow ? 'false' : 'true')
          })
        }

        const resetToDefault = () => {
          const fallbackInput = root.querySelector(`[data-shop-type-input][value="${defaultType}"]`)
          if (fallbackInput) {
            fallbackInput.checked = true
            fallbackInput.dispatchEvent(new Event('change', { bubbles: true }))
          }
          updateTypeViews()
        }

        const handleInputChange = (event) => {
          updateTypeViews()
        }

        typeInputs.forEach((input) => {
          input.addEventListener('change', handleInputChange)
          input.addEventListener('input', handleInputChange)
          listeners.push(() => {
            input.removeEventListener('change', handleInputChange)
            input.removeEventListener('input', handleInputChange)
          })
        })

        const handleRootClick = (event) => {
          const backButton = event.target?.closest?.('[data-shop-type-back]')
          if (backButton) {
            resetToDefault()
            return
          }

          const label = event.target?.closest?.('label')
          if (label && label.querySelector('[data-shop-type-input]')) {
            requestAnimationFrame(updateTypeViews)
          }
        }

        root.addEventListener('click', handleRootClick)
        listeners.push(() => root.removeEventListener('click', handleRootClick))

        updateTypeViews()
      }

      setupTypeViews()

      cleanupFn = () => {
        listeners.forEach((cleanup) => cleanup())
      }
    }

    initShopSidebar()
    document.addEventListener('astro:page-load', initShopSidebar)
  })()
</script>
