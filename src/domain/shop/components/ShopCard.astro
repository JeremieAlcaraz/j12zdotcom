---
import Card from '@/ui/organisms/Card.astro'
import ShopImage from '@/domain/shop/components/ShopImage.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  item: CollectionEntry<'shop'>
}

const { item } = Astro.props as Props
const {
  title,
  description,
  summary,
  cover,
  price,
  currency,
  type,
  productType,
  serviceType,
  categories = [],
  isNew,
} = item.data

const href = `/s-equiper/${item.id}`
const isFree = price === 0
const priceLabel = isFree ? 'Gratuit' : `${price} ${currency ?? 'EUR'}`
const typeLabel = type === 'product' ? 'Produit' : 'Service'
const subtype = productType ?? serviceType ?? ''

const categoryLabels: Record<string, string> = {
  notion: 'Notion',
  automatisation: 'Automatisation',
  ai: 'AI',
  sante: 'Sante',
  'prendre-soin': 'Prendre soin',
}

const subtypeLabels: Record<string, string> = {
  'templates-notion': 'Templates Notion',
  musiques: 'Musiques',
  prompts: 'Prompts',
  divers: 'Divers',
  formation: 'Formation',
  coaching: 'Coaching',
  ateliers: 'Ateliers',
}

const displayCategories = categories.map((category) => categoryLabels[category] ?? category)
const subtypeLabel = subtype ? subtypeLabels[subtype] ?? subtype : ''
const dataType = type === 'product' ? 'products' : 'services'
const dataCategories = categories.join('|')
---

<article
  class="shop-card"
  data-shop-item
  data-type={dataType}
  data-subtype={subtype}
  data-categories={dataCategories}
  data-price={price}
  data-is-new={isNew ? 'true' : 'false'}
>
  <Card class="flex h-full flex-col" base={100} shadow="sm" hover>
    {
      cover && (
        <div slot="image" class="aspect-square w-full overflow-hidden">
          <ShopImage
            class="h-full w-full object-cover"
            src={cover}
            alt={title}
            width={640}
            height={640}
            format="webp"
          />
        </div>
      )
    }
    <a slot="title" href={href} class="link link-hover line-clamp-2">
      {title}
    </a>
    <p class="text-sm text-base-content/70 line-clamp-3">
      {summary || description}
    </p>
    <div class="mt-4 flex items-center justify-between">
      <span class="price-tag text-sm font-semibold text-base-content">{priceLabel}</span>
      <a href={href} class="btn btn-primary btn-sm">Voir</a>
    </div>
  </Card>
</article>

<style>
  .price-tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.8rem 0.25rem 0.6rem;
    background: color-mix(in oklch, var(--color-primary) 22%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-primary) 55%, transparent);
    border-radius: 0.5rem;
  }

  .price-tag::after {
    content: '';
    position: absolute;
    right: -0.45rem;
    top: 50%;
    width: 0.9rem;
    height: 0.9rem;
    transform: translateY(-50%) rotate(45deg);
    background: color-mix(in oklch, var(--color-primary) 22%, transparent);
    border-top: 1px solid color-mix(in oklch, var(--color-primary) 55%, transparent);
    border-right: 1px solid color-mix(in oklch, var(--color-primary) 55%, transparent);
    border-radius: 0.2rem;
  }
</style>
