---
import ShopFiltersSidebar from '@/domain/shop/components/ShopFiltersSidebar.astro'
import { SHOP_FILTERS } from '@/domain/shop/filters'
import Icon from '@/ui/atoms/Icon.astro'

const sidebarId = 'shop-filters-demo'
---

<div class="rounded-3xl border border-base-200 bg-base-100/60 p-6">
  <div class="flex items-center justify-between lg:hidden">
    <p class="text-sm font-medium text-base-content/70">Aperçu mobile</p>
    <button
      type="button"
      class="btn btn-primary btn-sm gap-2"
      data-shop-sidebar-open={sidebarId}
      aria-controls={sidebarId}
      aria-expanded="false"
    >
      <Icon name="lucide:sliders-horizontal" size={16} />
      Filtres
    </button>
  </div>

  <div class="flex flex-col gap-6 lg:flex-row">
    <ShopFiltersSidebar
      id={sidebarId}
      filters={SHOP_FILTERS}
      class="lg:top-0 lg:h-auto lg:rounded-2xl lg:bg-base-100/80"
    />

    <div class="flex-1 space-y-4">
      <div class="rounded-2xl border border-base-200 bg-base-100/80 p-5">
        <h3 class="text-lg font-semibold text-base-content">Catalogue (placeholder)</h3>
        <p class="mt-2 text-sm text-base-content/70">
          Les cartes produits viendront ici. La sidebar reste indépendante de ces données.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="rounded-2xl border border-dashed border-base-200 bg-base-100/70 p-6 text-sm text-base-content/60">
          Produit A
        </div>
        <div class="rounded-2xl border border-dashed border-base-200 bg-base-100/70 p-6 text-sm text-base-content/60">
          Produit B
        </div>
      </div>
    </div>
  </div>
</div>
