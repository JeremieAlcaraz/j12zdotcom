---
import type { JSX } from 'astro/jsx-runtime'

type Props = {
  variant?: 'default' | 'bordered'
} & JSX.LabelHTMLAttributes

const { variant = 'default', class: className, ...rest } = Astro.props

const variantClasses = {
  default: 'border border-transparent',
  bordered: 'border border-base-300',
}

const classes = [
  'flex cursor-pointer items-center gap-3 rounded-2xl px-3 py-2 transition-colors',
  'hover:border-primary/20 hover:bg-base-200/60',
  variantClasses[variant],
  className,
]
  .filter(Boolean)
  .join(' ')
---

<label class={classes} {...rest}>
  <slot />
</label>
