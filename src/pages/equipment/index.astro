---
import BaseLayout from '@/layouts/Base.astro'
import EquipmentFiltersSidebar from '@/domain/equipment/components/EquipmentFiltersSidebar.astro'
import EquipmentGrid from '@/domain/equipment/components/EquipmentGrid.astro'
import { EQUIPMENT_FILTERS } from '@/domain/equipment/filters'
import Icon from '@/ui/atoms/Icon.astro'
import { getCollection } from 'astro:content'

const sidebarId = 'equipment-filters'
const equipmentItems = (await getCollection('shop')).filter((item) => !item.data.draft)
---

<BaseLayout title="S'équiper">
  <section class="py-8 sm:py-12">
    <div class="space-y-6">
      <div class="flex items-center justify-between lg:hidden">
        <h1 class="text-2xl font-semibold text-base-content">S'équiper</h1>
        <button
          type="button"
          class="btn btn-primary btn-sm gap-2"
          data-shop-sidebar-open={sidebarId}
          aria-controls={sidebarId}
          aria-expanded="false"
        >
          <Icon name="lucide:sliders-horizontal" size={16} />
          Filtres
        </button>
      </div>

      <div class="flex flex-col gap-8 lg:flex-row lg:items-start">
        <EquipmentFiltersSidebar id={sidebarId} filters={EQUIPMENT_FILTERS} />

        <div class="flex-1">
          <EquipmentGrid items={equipmentItems} sidebarId={sidebarId} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
